-- ===============================================
-- 6 Logica de los SP (Procedimientos almacenados)
-- ===============================================

-- 1. Automatizar el ingreso remoto de paqueteria
create PROCEDURE Sp_Registrar_Ingreso_Paquete
    @id_residente int,
    @id_empresa int,
    @descripcion varchar (max)
AS
BEGIN
    set Nocount ON

    -- Inserciones directas aprovechando las restricciones por defecto
    insert into Recepcion_Paquetes(id_residente, id_empresa, descripcion_paquete, estatus_entrega)
    VALUES(@id_residente, @id_empresa, @descripcion, 'En Caseta')
    
    -- Regresa el ID generado en tiempo real
    select SCOPE_IDENTITY() AS Nuevo_Id_Paquete
END

-- 2. Salida y Cierre de Custodia
create Procedure Sp_Procesar_Entrega_Residente
    @id_paquete int
AS
BEGIN
    set nocount on

    -- Validar el estado antes de modificar lso registros
    if exists (select 1 from Recepcion_Paquetes WHERE id_paquete = @id_paquete AND estatus_entrega = 'En Caseta')
    BEGIN
        Begin tran

        -- 1. Actualizar estado
        update Recepcion_Paquetes
        set estatus_entrega = 'Entregado'
        WHERE id_paquete = @id_paquete

        -- 2. Insercion automatica en el historial
        insert into Entregas_Residentes(id_paquete)
        VALUES(@id_paquete)
        commit tran
        print 'Transaccion Completa : Entrega realizada con exito de forma remota'
    END

    ELSE
    BEGIN
        Raiserror ('ERROR en validacion: Paquete no disponible en caseta', 16, 1)
    END
END
