-- ===============================================
-- 5 Crear una vista para para optimizacion
-- ===============================================
create VIEW Vw_Paquetes_pendientes as
    select 
        p.id_paquete AS [Folio_Interno],
        CONCAT(r.nombre, ' ', r.apellido) AS [Residente_Destinatario],
        CONCAT(r.torre_bloque, ' - Depto ', r.numero_departamento) AS [Ubicacion Residencial],
        e.nombre_empresa AS [Compania Logistica],
        p.fecha_recepcion AS [Fecha Ingreso],
        p.descripcion_paquete AS [Descripcion Fisica]
    from Recepcion_Paquetes p
    INNER JOIN Residentes r on p.id_residente = r.id_residente
    INNER JOIN Empresas_Paquetaria e on p.id_empresa = e.id_empresa
    WHERE p.estatus_entrega = 'En Caseta'

