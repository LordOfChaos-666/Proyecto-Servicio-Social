-- ===============================================
-- 1 Crear la base de datos 
-- ===============================================

create database SafeDropSQL
use SafeDropSQL

-- ===============================================
-- 2 Creacion de las primeras tablas
-- ===============================================

-- Tabla de recidentes
CREATE TABLE Residentes 
(
    id_residente INT IDENTITY(1,1) NOT NULL,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    torre_bloque VARCHAR(20) NOT NULL,
    numero_departamento VARCHAR(20) NOT NULL,
    telefono VARCHAR(15) NOT NULL,
    estatus BIT DEFAULT 1 NOT NULL, -- 1 = Activo, 0 = Inactivo (Mudanza)
    CONSTRAINT PK_Residentes PRIMARY KEY (id_residente)
);

-- Tabla de empresas de paqueteria
CREATE TABLE Empresas_Paquetaria 
(
    id_empresa INT IDENTITY(1,1) NOT NULL,
    nombre_empresa VARCHAR(50) NOT NULL,
    CONSTRAINT PK_Empresas_Paquetaria PRIMARY KEY (id_empresa)
);

-- ===============================================
-- 3 Tabla del control operativo y control
-- ===============================================

-- Tabla central: Recepcion de paquetes
CREATE TABLE Recepcion_Paquetes 
(
    id_paquete INT IDENTITY(1,1) NOT NULL,
    id_residente INT NOT NULL,
    id_empresa INT NOT NULL,
    fecha_recepcion DATETIME DEFAULT GETDATE() NOT NULL, -- Sello temporal automático del servidor
    descripcion_paquete VARCHAR(250) NULL,
    estatus_entrega VARCHAR(20) DEFAULT 'En Caseta' NOT NULL,
    CONSTRAINT PK_Recepcion_Paquetes PRIMARY KEY (id_paquete),
    CONSTRAINT FK_Recepcion_Residentes FOREIGN KEY (id_residente) 
        REFERENCES Residentes(id_residente),
    CONSTRAINT FK_Recepcion_Empresas FOREIGN KEY (id_empresa) 
        REFERENCES Empresas_Paquetaria(id_empresa),
    -- Restricción CHECK para garantizar la integridad de los estados lógicos
    CONSTRAINT CK_Estatus_Entrega CHECK (estatus_entrega IN ('En Caseta', 'Entregado', 'Rechazado'))
);

-- Tabla de evidencias digitales
CREATE TABLE Evidencias_Digitales 
(
    id_evidencia INT IDENTITY(1,1) NOT NULL,
    id_paquete INT NOT NULL,
    ruta_fotografia VARCHAR(500) NOT NULL, -- Dirección URL o Path en el servidor de archivos remoto
    tipo_evidencia VARCHAR(50) NOT NULL, -- Ej: 'Estado de recepcion', 'Firma de conformidad'
    CONSTRAINT PK_Evidencias_Digitales PRIMARY KEY (id_evidencia),
    CONSTRAINT FK_Evidencias_Paquetes FOREIGN KEY (id_paquete) 
        REFERENCES Recepcion_Paquetes(id_paquete) ON DELETE CASCADE
);

-- Tabla de entrega de paquetes 
CREATE TABLE Entregas_Residentes
(
    id_entrega INT IDENTITY(1,1) NOT NULL,
    id_paquete INT NOT NULL,
    fecha_entrega DATETIME DEFAULT GETDATE() NOT NULL, -- Registra el momento exacto del reclamo físico
    CONSTRAINT PK_Entregas_Residentes PRIMARY KEY (id_entrega),
    CONSTRAINT FK_Entregas_Paquetes FOREIGN KEY (id_paquete) 
        REFERENCES Recepcion_Paquetes(id_paquete)
);

